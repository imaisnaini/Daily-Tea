<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme forced to Light Mode without legacy ActionBar -->
    <style name="Theme.DailyTea" parent="Theme.MaterialComponents.Light">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_yellow</item>
        <item name="colorSecondaryVariant">@color/soft_yellow</item>
        <item name="colorOnSecondary">@color/text_on_yellow</item>

        <!-- Background & Surface colors -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>

        <!-- Status bar color matching light background -->
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>